---
layout: default.njk
pagination:
  data: collections
  size: 1
  alias: tag
  # Internal collections, not hashtags - these shouldn't get a page
  filter:
    - all
    - beer
    - brewery
    - shop
    - style
    - styleMain
    - styleMainNames
    - sortedBreweries
    - sortedStyles
    - sortedShops
    - sortedStyleMains
    - breweryAliases
    - shopAliases
    - styleAliases
    - breweryStyle
    - breweryShop
    - styleShop
    - breweryStyleShop
    - breweryStyleCombos
    - breweryShopCombos
    - styleShopCombos
    - breweryStyleShopCombos
permalink: /category/{{ tag }}/
# Hashtag pages overlap the style pages, so keep them out of search results
noindex: true
eleventyComputed:
  seoTitle: "{{ tag }}"
---

<div class="container blog-container">
	<h1>{{ tag }}</h1>


	<ul class="list">
		{% if tag %}
			{% set categoryList = collections[ tag ] %}
			{% for beer in categoryList | reverse %}
				{% include 'beer.njk' %}
			{% endfor %}
		{% endif %}
	</ul>
</div>
