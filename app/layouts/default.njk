<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	{% set pageTitle = (seoTitle + " | " + meta.site.title) if seoTitle else (meta.site.title + " - " + meta.site.description) %}
	{% set metaDescription = intro or description %}
	<title>{{ pageTitle }}</title>
	{% if noindex %}<meta name="robots" content="noindex, follow">{% endif %}
	<link rel="home" href="{{ meta.site.url }}/" />

	<meta name="viewport" content="width=device-width,initial-scale=1,minimum-scale=1">

	<link rel="manifest" href="/site.webmanifest">

	<link rel="apple-touch-icon" sizes="57x57" href="/assets/img/apple-touch-icon-57x57.png">
	<link rel="apple-touch-icon" sizes="60x60" href="/assets/img/apple-touch-icon-60x60.png">
	<link rel="apple-touch-icon" sizes="72x72" href="/assets/img/apple-touch-icon-72x72.png">
	<link rel="apple-touch-icon" sizes="76x76" href="/assets/img/apple-touch-icon-76x76.png">
	<link rel="apple-touch-icon" sizes="114x114" href="/assets/img/apple-touch-icon-114x114.png">
	<link rel="apple-touch-icon" sizes="120x120" href="/assets/img/apple-touch-icon-120x120.png">
	<link rel="apple-touch-icon" sizes="144x144" href="/assets/img/apple-touch-icon-144x144.png">
	<link rel="apple-touch-icon" sizes="152x152" href="/assets/img/apple-touch-icon-152x152.png">
	<link rel="apple-touch-icon" sizes="180x180" href="/assets/img/apple-touch-icon-180x180.png">
	<link rel="icon" type="image/png" href="/assets/img/favicon_192.png" sizes="192x192">

	<link rel="canonical" href="{{ meta.site.url }}{{ page.url }}" />
	<link rel="me" href="https://hachyderm.io/@mikestreety">

	<meta name="msapplication-square70x70logo" content="/assets/img/smalltile.png" />
	<meta name="msapplication-square150x150logo" content="/assets/img/mediumtile.png" />
	<meta name="msapplication-wide310x150logo" content="/assets/img/widetile.png" />
	<meta name="msapplication-square310x310logo" content="/assets/img/largetile.png" />

	<meta name="msapplication-TileColor" content="{{ meta.themeColour }}">
	<meta name="msapplication-config" content="/browserconfig.xml">
	<meta name="theme-color" content="{{ meta.themeColour }}">

	<meta name="description" content="{{ metaDescription }}"/>
	<meta name="author" content="{{ meta.author }}">
	<meta name="fediverse:creator" content="@Ale_house_rock@mastodon.beer">

	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:site" content="@{{ meta.social.twitter }}">
	<meta name="twitter:creator" content="@{{ meta.social.twitter }}">

	<meta property="og:type" content="{{ 'article' if rating else 'website' }}">
	<meta property="og:title" content="{{ pageTitle }}">
	<meta name="twitter:title" content="{{ pageTitle }}">
	<meta property="og:description" content="{{ metaDescription }}">
	<meta name="twitter:description" content="{{ metaDescription }}">
	<meta property="og:url" content="{{ meta.site.url }}{{ page.url }}">
	<meta property="og:site_name" content="{{ meta.site.title }}">
	{% if socialMediaPhoto %}
	<meta property="og:image" content="{{ socialMediaPhoto }}">
	<meta name="twitter:image" content="{{ socialMediaPhoto }}">
	<meta property="og:image:width" content="1000">
	<meta property="og:image:height" content="1000">
	{% else %}
	<meta property="og:image" content="{{ meta.site.url }}/assets/img/logo.png">
	<meta name="twitter:image" content="{{ meta.site.url }}/assets/img/logo.png">
	{% endif %}
	{% set count = 1 %}
	{% if rating %}
	<meta name="twitter:label{{ count }}" content="Rating">
	<meta name="twitter:data{{ count }}" content="{{ rating }}/10">
	{% set count = count + 1 %}
	{% endif %}
	{% if brewedBy %}
	<meta name="twitter:label{{ count }}" content="Brewery">
	<meta name="twitter:data{{ count }}" content="{{ brewedBy }}">
	{% set count = count + 1 %}
	{% endif %}
	{% if abv %}
	<meta name="twitter:label{{ count }}" content="ABV">
	<meta name="twitter:data{{ count }}" content="{{ abv }}">
	{% set count = count + 1 %}
	{% endif %}
	{% if beers.length %}
	<meta name="twitter:label{{ count }}" content="Beers reviewed">
	<meta name="twitter:data{{ count }}" content="{{ beers.length }}">
	{% set count = count + 1 %}
	{% endif %}
	{% if stats.mean %}
	<meta name="twitter:label{{ count }}" content="Average score">
	<meta name="twitter:data{{ count }}" content="{{ stats.mean }}/10">
	{% set count = count + 1 %}
	{% endif %}

	{% if schema %}<script type="application/ld+json">{{ schema | jsonLd | safe }}</script>{% endif %}

	<link rel="preconnect" href="https://gc.zgo.at" crossorigin>
	<link rel="preload" href="/assets/css/style.css" as="style">
	<link rel="preload" href="/assets/fonts/poppins-v8-latin-700.woff2" as="font" type="font/woff2" crossorigin>

	<link rel="stylesheet" href="/assets/css/style.css">

	<script data-goatcounter="https://alehouserocks.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>

	<script>
	if ('serviceWorker' in navigator) {
		navigator.serviceWorker.register('/sw.js?1');
	}
	</script>
</head>

<body {% if bodyclass is defined %}class="{{ bodyclass }}"{% endif %}>
	<div class="site" id="site" data-display="list">
		<header>
			<a href="/">
				<img src="/assets/img/logo.svg" width="140" height="143" alt="">
				{% if page.url == '/' %}<h1 class="siteName">Ale<br>House<br>Rock</h1>{% else %}<span class="siteName">Ale<br>House<br>Rock</span>{% endif %}
			</a>

			<button type="button" class="navToggle" id="navToggle" aria-expanded="false" aria-controls="siteNav" onclick="toggleNav()">
				<span class="navToggle-bar"></span>
				<span class="visually-hidden">Menu</span>
			</button>
		</header>

		<nav class="siteNav" id="siteNav">
			<ul>
				<li><a href="/beers/">Beers</a></li>
				<li><a href="/breweries/">Breweries</a></li>
				<li><a href="/shops/">Shops</a></li>
				<li><a href="/styles/">Styles</a></li>
			</ul>
		</nav>

		<main class="content">
			<aside class="filters">
				<form action="/search/" method="get">
					<input type="search" name="q" placeholder="Search for a beer" class="input" id="searchbox">
					<input type="submit" value="Search" class="button">
				</form>

				{% if not hideFilters %}
				<div class="filtersBox">
				<button type="button" class="filtersToggle" id="filtersToggle" aria-expanded="false" aria-controls="filtersPanel" onclick="toggleFilters()">Filters</button>

				<div class="filtersPanel" id="filtersPanel">
					<div class="filterField">
						<div class="filterLabelRow">
							<label for="filterBrewery">Brewery</label>
							{% if breweryActive %}<a class="filterClear" href="{{ allBreweryUrl }}">Clear</a>{% endif %}
						</div>
						<select class="brewerySearch" id="filterBrewery" onchange="jumpto(this)">
							<option value="{{ allBreweryUrl if allBreweryUrl else '' }}">All</option>
							{% for brewery in filterBreweries or collections.sortedBreweries %}
							<option value="{{ brewery.url }}" {% if brewery.active %}selected{% endif %}>{{ brewery.title if brewery.title else brewery.data.title }}{% if brewery.data %} ({{ brewery.data.beers.length }}){% endif %}</option>
							{% endfor %}
						</select>
					</div>

					<div class="filterField">
						<div class="filterLabelRow">
							<label for="filterStyle">Style</label>
							{% if styleActive %}<a class="filterClear" href="{{ allStyleUrl }}">Clear</a>{% endif %}
						</div>
						<select class="styleSearch" id="filterStyle" onchange="jumpto(this)">
							<option value="{{ allStyleUrl if allStyleUrl else '' }}">All</option>
							{% for style in filterStyles or collections.sortedStyleMains %}
							<option value="{{ style.url }}" {% if style.active %}selected{% endif %}>{{ style.title if style.title else style.data.title }}{% if style.data %} ({{ style.data.beers.length }}){% endif %}</option>
							{% endfor %}
						</select>
					</div>

					<div class="filterField">
						<div class="filterLabelRow">
							<label for="filterShop">Shop</label>
							{% if shopActive %}<a class="filterClear" href="{{ allShopUrl }}">Clear</a>{% endif %}
						</div>
						<select class="shopSearch" id="filterShop" onchange="jumpto(this)">
							<option value="{{ allShopUrl if allShopUrl else '' }}">All</option>
							{% for shop in filterShops or collections.sortedShops %}
							<option value="{{ shop.url }}" {% if shop.active %}selected{% endif %}>{{ shop.title if shop.title else shop.data.title }}{% if shop.data %} ({{ shop.data.beers.length }}){% endif %}</option>
							{% endfor %}
						</select>
					</div>
				</div>
				</div>
				{% endif %}

				<div class="displayType">
					<button class="displayList" onclick="changeDisplay('list')"><span>≣</span> List</button>
					<button class="displayGrid" onclick="changeDisplay('grid')"><span>⩩</span> Grid</button>
				</div>
			</aside>
			{{ content | safe }}
		</main>

		<footer class="footer">
			<div class="container">
				<p><a href="/stats/">Stats</a> | <a href="/breweries/">View all breweries</a> | <a href="/beers/">View all beers</a> | <a href="/styles/">View all styles</a> | <a href="/shops/">View all purchased locations</a> | <a href="/rss">RSS Feed</a></p>
				<p><a class="h-card" rel="me" href="{{ meta.site.url }}">{{ meta.site.title }}</a> is made & reviewed by <a class="h-card" rel="me" href="https://www.mikestreety.co.uk">Mike Street</a> | View the code on <a href="https://github.com/mikestreety/ale-house-rock">Github</a> | <a rel="me" href="https://mastodon.beer/@Ale_house_rock">Mastodon</a></p>
			</div>
		</footer>
	</div>

	<script>
	function toggleNav() {
		const nav = document.getElementById('siteNav');
		const toggle = document.getElementById('navToggle');
		const isOpen = nav.classList.toggle('isOpen');
		toggle.setAttribute('aria-expanded', isOpen);
	}

	function jumpto(item) {
		if (item.value) {
			document.location.href = item.value;
		}
	}

	function toggleSection(panelId, toggleId) {
		const panel = document.getElementById(panelId);
		const toggle = document.getElementById(toggleId);
		const isOpen = panel.classList.toggle('isOpen');
		toggle.setAttribute('aria-expanded', isOpen);
		return isOpen;
	}

	function toggleFilters() {
		toggleSection('filtersPanel', 'filtersToggle');
	}

	function toggleStats() {
		toggleSection('statsPanel', 'statsToggle');
	}

	function changeDisplay(type) {
		window.localStorage.setItem('displayType', type);
		document.getElementById('site').dataset.display = type;
	}

	if(window.localStorage.getItem('displayType')) {
		changeDisplay(window.localStorage.getItem('displayType'));
	}
	</script>

	<script data-schema="Organization" type="application/ld+json">{"@context":"http:\/\/schema.org","@type":"Organization","name":"Ale House Rock","url":"{{ meta.site.url }}","logo":"{{ meta.site.url }}/assets/img/logo.png","sameAs":["https://mastodon.beer/@Ale_house_rock","https://untappd.com/user/mikestreety","https://github.com/mikestreety/ale-house-rock"]}</script>
	<script data-schema="WebSite" type="application/ld+json">{"@context":"http:\/\/schema.org","@type":"WebSite","name":"Ale House Rock","url":"{{ meta.site.url }}"}</script>

</body>
</html>
